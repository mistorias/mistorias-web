---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import QuipuDeTemas from "../../components/QuipuDeTemas.astro";
import { sortByDateDescending } from "../../lib/stories";
import { groupByInitial, groupByTheme } from "../../lib/themes";

const historias = sortByDateDescending(
    await getCollection("stories"),
    (historia) => historia.id,
    (historia) => historia.data.date
);

const letras = groupByInitial(
    groupByTheme(historias, (historia) => historia.data.themes ?? [])
);
---

<BaseLayout
    title="Temas | Mistorias"
    description="Los temas que atraviesan las historias de Mistorias."
>
    <div class="columna temas-indice">
        <h1>Temas</h1>

        <p class="temas-indice__entrada">
            Los temas que distinguen a una historia de las demás, de la A a la Z.
        </p>

        {
            letras.length > 0 ? (
                <QuipuDeTemas letras={letras} />
            ) : (
                <p>Todavía no hay temas publicados.</p>
            )
        }
    </div>
</BaseLayout>

<style>
    .temas-indice {
        padding-block-start: var(--esp-xl);
    }

    .temas-indice__entrada {
        margin-block-start: var(--esp-m);
        color: var(--color-analitico);
    }

    .temas-indice :global(.quipu-letras) {
        margin-block-start: var(--esp-l);
    }
</style>
