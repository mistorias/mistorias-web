---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import IndiceDeLetras from "../../components/IndiceDeLetras.astro";
import QuipuDeTemas from "../../components/QuipuDeTemas.astro";
import { themeRoute } from "../../lib/routes";
import { countStories, sortByDateDescending } from "../../lib/stories";
import {
    groupByInitial,
    groupByTheme,
    mostCoveredThemes
} from "../../lib/themes";

const historias = sortByDateDescending(
    await getCollection("stories"),
    (historia) => historia.id,
    (historia) => historia.data.date
);

const grupos = groupByTheme(historias, (historia) => historia.data.themes ?? []);
const letras = groupByInitial(grupos);
const masTocados = mostCoveredThemes(grupos);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
    title="Temas | Mistorias"
    description="Los temas que atraviesan las historias de Mistorias."
>
    <div class="columna temas-indice">
        <h1>Temas</h1>

        <p class="temas-indice__entrada">
            Los temas que distinguen a una historia de las demás, de la A a la Z.
        </p>

        {
            masTocados.length > 0 && (
                <section
                    class="temas-indice__mas-tocados"
                    aria-labelledby="mas-tocados"
                >
                    <h2 id="mas-tocados">Los más tocados</h2>
                    <ol class="temas-indice__fichas">
                        {masTocados.map((grupo) => (
                            <li>
                                <a
                                    class="temas-indice__ficha"
                                    href={themeRoute(base, grupo.theme)}
                                >
                                    <span class="temas-indice__nombre">
                                        {grupo.theme}
                                    </span>
                                    <span class="temas-indice__cuenta">
                                        {countStories(grupo.stories.length)}
                                    </span>
                                </a>
                            </li>
                        ))}
                    </ol>
                </section>
            )
        }

        {
            letras.length > 0 ? (
                <IndiceDeLetras letras={letras.map((letra) => letra.initial)}>
                    <QuipuDeTemas letras={letras} />
                </IndiceDeLetras>
            ) : (
                <p>Todavía no hay temas publicados.</p>
            )
        }
    </div>
</BaseLayout>

<style>
    .temas-indice {
        padding-block-start: var(--esp-xl);
    }

    .temas-indice__entrada {
        margin-block-start: var(--esp-m);
        color: var(--color-analitico);
    }

    .temas-indice :global(.quipu-letras) {
        margin-block-start: var(--esp-l);
    }

    .temas-indice__mas-tocados {
        margin-block-start: var(--esp-l);
    }

    .temas-indice__mas-tocados h2 {
        font-size: var(--paso-1);
    }

    .temas-indice__fichas {
        display: grid;
        gap: var(--esp-2xs);
        grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
        margin-block-start: var(--esp-s);
        padding: 0;
        list-style: none;
    }

    /* Que las tres fichas de una fila tengan el mismo alto aunque un nombre largo parta en dos. */
    .temas-indice__fichas li {
        display: grid;
    }

    .temas-indice__ficha {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--esp-s);
        align-items: baseline;
        justify-content: space-between;
        min-height: 44px;
        padding: var(--esp-2xs) var(--esp-xs);
        border: 1px solid var(--color-borde);
        border-radius: var(--radio);
        background-color: var(--color-superficie);
        text-decoration: none;
    }

    .temas-indice__nombre {
        font-family: var(--fuente-info);
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .temas-indice__cuenta {
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        color: var(--color-metadato);
    }

    @media (hover: hover) {
        .temas-indice__ficha:hover {
            border-color: var(--color-vivo);
        }
    }
</style>
