---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TarjetaHistoria from "../../components/TarjetaHistoria.astro";
import { themesRoute } from "../../lib/routes";
import { sortByDateDescending } from "../../lib/stories";
import { groupByTheme } from "../../lib/themes";
import { authorNameFor, buildAuthorNameMap } from "../../lib/content/authors";

export async function getStaticPaths() {
    const stories = sortByDateDescending(
        await getCollection("stories"),
        (story) => story.id,
        (story) => story.data.date
    );

    return groupByTheme(stories, (story) => story.data.themes ?? []).map(
        (group) => ({
            params: { tema: group.theme },
            props: { historias: group.stories }
        })
    );
}

type Props = {
    historias: readonly CollectionEntry<"stories">[];
};

const { tema } = Astro.params;
const { historias } = Astro.props;

const authorNames = buildAuthorNameMap(
    await getCollection("authors"),
    (author) => author.id,
    (author) => author.data.name
);
---

<BaseLayout
    title={`Historias sobre ${tema} | Mistorias`}
    description={`Historias de Mistorias sobre ${tema}.`}
>
    <div class="contenedor tema">
        <p class="tema__rotulo">Tema</p>
        <h1>{tema}</h1>

        <p class="tema__cuenta">
            {historias.length === 1
                ? "1 historia con este tema"
                : `${historias.length} historias con este tema`}
        </p>

        <div class="tema__rejilla">
            {
                historias.map((story) => (
                    <TarjetaHistoria
                        historia={story}
                        nombreAutor={authorNameFor(
                            authorNames,
                            story.data.author.id
                        )}
                    />
                ))
            }
        </div>

        <p class="tema__volver">
            <a href={themesRoute(import.meta.env.BASE_URL)}>
                Ver todos los temas
            </a>
        </p>
    </div>
</BaseLayout>

<style>
    .tema {
        padding-block-start: var(--esp-xl);
    }

    .tema__rotulo {
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-metadato);
    }

    .tema__cuenta {
        margin-block-start: var(--esp-2xs);
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        color: var(--color-metadato);
    }

    .tema__rejilla {
        display: grid;
        gap: var(--esp-m);
        margin-block-start: var(--esp-l);
        grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    }

    .tema__volver {
        margin-block-start: var(--esp-l);
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
    }
</style>
