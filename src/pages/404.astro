---
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeRoute, reportRoute, themesRoute } from "../lib/routes";

const base = import.meta.env.BASE_URL;

// Como el sitio es estático, esta página no sabe qué dirección se pidió de
// verdad: el servidor sirve el mismo 404.html sin importar la ruta (issue #42
// de gestión de producto). En vez de intentar adivinarla, se invita a quien
// llegó acá a contarnos ella misma qué enlace siguió.
const enlaceReporte = `${reportRoute(base)}#formulario`;
---

<BaseLayout
    title="Página no encontrada | Mistorias"
    description="La dirección que buscabas no existe en Mistorias."
>
    <div class="columna no-encontrada">
        <p class="no-encontrada__codigo">Error 404</p>

        <h1>Esta página no existe</h1>

        <p class="no-encontrada__mensaje">
            Puede que la dirección haya cambiado o que el enlace que seguiste
            tenga un error. No es culpa tuya, y desde acá se sale rápido.
        </p>

        <ul class="no-encontrada__salidas" role="list">
            <li><a href={homeRoute(base)}>Ir a la portada</a></li>
            <li>
                <a href={themesRoute(base)}>Explorar las historias por tema</a>
            </li>
        </ul>

        <p class="no-encontrada__reporte">
            Si veniste desde un enlace de este mismo sitio, <a
                href={enlaceReporte}>cuéntanos cuál era</a
            > y lo revisamos.
        </p>
    </div>
</BaseLayout>

<style>
    .no-encontrada {
        padding-block: var(--esp-2xl);
    }

    .no-encontrada__codigo {
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-metadato);
    }

    .no-encontrada__mensaje {
        max-width: 50ch;
        margin-block-start: var(--esp-m);
        font-size: var(--paso-1);
        color: var(--color-analitico);
    }

    .no-encontrada__salidas {
        display: grid;
        gap: var(--esp-2xs);
        justify-items: start;
        margin-block-start: var(--esp-l);
        padding: 0;
        list-style: none;
    }

    .no-encontrada__salidas a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        font-family: var(--fuente-info);
        font-weight: 600;
    }

    .no-encontrada__reporte {
        max-width: 50ch;
        margin-block-start: var(--esp-l);
        font-size: var(--paso--1);
        color: var(--color-metadato);
    }
</style>
