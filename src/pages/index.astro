---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import DatoConFuente from "../components/DatoConFuente.astro";
import PlantaDeLibros from "../components/PlantaDeLibros.astro";
import TarjetaHistoria from "../components/TarjetaHistoria.astro";
import { reportRoute, themesRoute } from "../lib/routes";
import { limitPreviousStories, sortByDateDescending } from "../lib/stories";

const historias = sortByDateDescending(
    await getCollection("stories"),
    (historia) => historia.data.date
);

const [destacada, ...resto] = historias;
const anteriores = limitPreviousStories(resto);
const hayTemas = historias.some((historia) => (historia.data.themes ?? []).length > 0);

// La portada abre con datos verificables antes de prometer nada (issue #37 de
// gestión de producto): dos cifras que incomodan y que cualquiera puede
// comprobar, porque cada una enlaza a su fuente. Prometer sin haber generado
// esa tensión deja a quien llega sin razones para quedarse.
//
// MANTENIMIENTO: las dos cifras son del ciclo que nombra `CICLO_DE_LOS_DATOS`.
// Cuando la OCDE publique el siguiente ciclo de PISA hay que revisarlas acá; es
// el precio de usar datos duros dentro de un texto fijo.
const CICLO_DE_LOS_DATOS = "PISA 2022";

const datos = [
    {
        cifra: "Uno de cada tres",
        resto: "jóvenes peruanos de quince años alcanza el mínimo de matemática que la OCDE considera necesario para la vida adulta.",
        fuente: `Minedu–UMC, ${CICLO_DE_LOS_DATOS}`,
        href: "https://www.gob.pe/institucion/minedu/noticias/877904-pisa-2022-el-peru-mantiene-sus-resultados-en-las-competencias-de-lectura-y-ciencia",
        detalle: "34 % de estudiantes peruanos alcanzó el nivel 2 o superior en Matemática, y ese nivel 2 es el mínimo para desenvolverse en el mundo actual. Lo publica el propio Estado evaluado."
    },
    {
        cifra: "Solo el 1 %",
        resto: "llega al nivel más alto en lectura.",
        fuente: `OCDE, ${CICLO_DE_LOS_DATOS}`,
        href: "https://www.oecd.org/en/publications/pisa-2022-results-volume-i-and-ii-country-notes_ed6fbcc5-en/peru_3e71791c-en.html",
        detalle: "1 % de estudiantes peruanos en nivel 5 o superior, frente al 7 % del promedio de la OCDE. Lo mide un organismo externo, sin interés en el resultado peruano."
    }
] as const;
---

<BaseLayout
    title="Mistorias | Historias para transformar la educación"
    description="Queremos que veas, entiendas y quieras transformar la educación."
>
    <section class="portada">
        <div class="contenedor portada__disposicion">
            <PlantaDeLibros />

            <div class="portada__texto">
                <h1>Historias para transformar la educación</h1>

                <div class="portada__entrada">
                    {
                        datos.map((dato) => (
                            <>
                                <DatoConFuente
                                    fuente={dato.fuente}
                                    href={dato.href}
                                    detalle={dato.detalle}
                                    grupo="fuentes-portada"
                                >
                                    <strong class="portada__cifra">
                                        {dato.cifra}
                                    </strong>{" "}
                                    {dato.resto}
                                </DatoConFuente>{" "}
                            </>
                        ))
                    }
                </div>

                <p class="portada__entrada">
                    No es un problema de escuelas lejanas: es el país que mañana
                    te atenderá, te contratará y decidirá contigo.
                </p>

                <p class="portada__promesa">
                    Detrás de cada cifra hay una persona con nombre. En pocos
                    minutos te ayudamos a empatizar con ella: <strong
                        >adéntrate</strong
                    > en una historia, <strong>entiende</strong> por qué se repite
                    en miles más y <strong>convierte</strong> esa comprensión en algo
                    concreto para mejorar nuestra educación: en tu casa, en tu colegio
                    o frente a quien tiene el poder de cambiarla.
                </p>
            </div>
        </div>
    </section>

    {
        destacada && (
            <section class="destacada" aria-label="Última historia">
                <div class="columna">
                    <p class="destacada__rotulo">Última historia</p>
                    <TarjetaHistoria historia={destacada} destacada />
                </div>
            </section>
        )
    }

    {
        anteriores.length > 0 && (
            <section class="anteriores">
                <div class="contenedor">
                    <h2>Historias anteriores</h2>

                    <div class="anteriores__rejilla">
                        {anteriores.map((historia) => (
                            <TarjetaHistoria
                                historia={historia}
                                nivelTitulo={3}
                            />
                        ))}
                    </div>
                </div>
            </section>
        )
    }

    {
        historias.length === 0 && (
            <section class="columna vacia">
                <p>
                    Todavía no hay historias publicadas. La primera está en
                    camino.
                </p>
            </section>
        )
    }

    {
        hayTemas && (
            <section class="columna explorar">
                <a href={themesRoute(import.meta.env.BASE_URL)}>
                    Explorar las historias por tema
                </a>
            </section>
        )
    }

    <section class="columna feedback">
        <p>
            ¿Tienes algo que decirnos sobre el sitio? <a
                href={reportRoute(import.meta.env.BASE_URL)}
                >Cuéntanos qué encontraste</a
            >.
        </p>
    </section>
</BaseLayout>

<style>
    .portada {
        padding-block: var(--esp-2xl) var(--esp-xl);
        border-block-end: 1px solid var(--color-borde);
        background-color: var(--color-realce);
    }

    /*
     * `wrap-reverse` es lo que resuelve el pedido: la ilustración a la
     * izquierda cuando hay ancho y debajo del texto cuando no. Invierte el eje
     * transversal, no el principal, así que sin envolver la imagen queda a la
     * izquierda —es la primera del DOM— y al envolver su línea se dibuja
     * abajo. Sin `wrap-reverse` haría falta un punto de quiebre por ancho, que
     * es justo lo que base.css evita.
     *
     * `align-items: center` también es a propósito: bajo `wrap-reverse` el eje
     * transversal está invertido y `flex-start` alinearía abajo. `center` no
     * depende de esa inversión.
     */
    .portada__disposicion {
        display: flex;
        flex-wrap: wrap-reverse;
        align-items: center;
        gap: var(--esp-l) var(--esp-xl);
    }

    /*
     * `min-width: 0` porque el mínimo automático de un elemento flexible es su
     * tamaño mínimo de contenido, y sin esto el texto se niega a encogerse por
     * debajo de su base y se desborda en celular.
     */
    .portada__texto {
        flex: 1 1 30rem;
        min-width: 0;
        max-width: var(--medida);
    }

    /*
     * El tamaño del dibujo es fluido, no dos tamaños con un punto de quiebre
     * entre medio. Da ~18rem en escritorio y va bajando con el ancho, así que
     * cuando la fila envuelve —alrededor de 710px— el dibujo ya viene chico y
     * pasa abajo sin dar un salto. Los topes existen porque el dibujo es muy
     * vertical (proporción 0.467: 18rem de ancho son 38.5rem de alto): sin el
     * máximo domina la portada, y sin el mínimo desaparece en celular.
     *
     * Se descartó resolverlo con una @container sobre la fila, que era lo
     * natural para distinguir "al costado" de "abajo". Dos razones, las dos
     * verificadas en navegador: `container-type` aplica `contain: layout`, y
     * eso convierte al contenedor en bloque contenedor de los descendientes
     * `position: fixed` —la barra de fuentes de DatoConFuente dejaba de
     * anclarse a la ventana (ADR 0010)—; y el tamaño consultado alimentaba la
     * decisión de envolver, así que achicar el dibujo lo hacía entrar de nuevo
     * en la fila y la consulta nunca coincidía con el envolvimiento.
     */
    .portada__disposicion :global(.planta-de-libros) {
        flex: 0 1 clamp(7rem, 22vw, 18rem);
        margin-inline: auto;
    }

    /*
     * El celular horizontal (844 × 390) es ancho: no envuelve, y el dibujo
     * queda al lado del texto en una pantalla de 24rem de alto. Se corta por
     * altura —el mismo criterio que base.css ya usa— porque la restricción
     * real acá es el alto, no el ancho.
     */
    @media (max-height: 30rem) {
        .portada__disposicion :global(.planta-de-libros) {
            flex-basis: 9rem;
        }
    }

    /*
     * Es la entrada de la portada: dos afirmaciones con dato duro que se leen
     * como un solo párrafo, cada una con su fuente a pedido. La tercera frase
     * (el `<p>` siguiente, misma clase) toma el mismo tratamiento tipográfico
     * a propósito, para que la transición hacia la promesa se lea de un tirón.
     */
    .portada__entrada {
        max-width: 55ch;
        margin-block-start: var(--esp-l);
        font-size: var(--paso-1);
        color: var(--color-texto);
    }

    .portada__entrada + .portada__entrada {
        margin-block-start: var(--esp-m);
    }

    .portada__cifra {
        font-weight: 600;
        color: var(--color-acento);
    }

    .portada__promesa {
        max-width: 55ch;
        margin-block-start: var(--esp-xl);
    }

    .portada__promesa strong {
        font-weight: 600;
        color: var(--color-analitico);
    }

    .destacada {
        padding-block-start: var(--esp-xl);
    }

    .destacada__rotulo {
        margin-block-end: var(--esp-xs);
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-metadato);
    }

    .anteriores {
        padding-block-start: var(--esp-xl);
    }

    /*
     * `auto-fit` con un mínimo de 22rem resuelve solo: una columna en celular,
     * dos desde tableta vertical, y el tope del contenedor la deja en dos en
     * escritorio. Sin puntos de quiebre, y seguirá siendo correcta en anchos
     * que hoy no existen.
     */
    .anteriores__rejilla {
        display: grid;
        gap: var(--esp-m);
        margin-block-start: var(--esp-m);
        grid-template-columns: repeat(auto-fit, minmax(22rem, 1fr));
    }

    .vacia,
    .explorar,
    .feedback {
        padding-block-start: var(--esp-xl);
    }

    .explorar a {
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
    }

    .feedback {
        font-size: var(--paso--1);
        color: var(--color-metadato);
    }
</style>
