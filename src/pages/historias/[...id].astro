---
import { Picture } from "astro:assets";
import {
    getCollection,
    render,
    type CollectionEntry
} from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ListaTemas from "../../components/ListaTemas.astro";
import NavegacionHistorias from "../../components/NavegacionHistorias.astro";
import SimboloMistorias from "../../components/SimboloMistorias.astro";
import { dateForAttribute, readableDate } from "../../lib/dates";
import { themesRoute } from "../../lib/routes";
import { getStoryImage } from "../../lib/content/story-images";
import { orderStoriesByDate } from "../../lib/content/story-order";
import { resolveNeighbors } from "../../lib/content/story-order-cache";

export async function getStaticPaths() {
    const stories = await getCollection("stories");
    const storiesById = new Map(stories.map((story) => [story.id, story]));

    const orderedIds = orderStoriesByDate(
        stories,
        (story) => story.id,
        (story) => story.data.date
    );
    const neighbors = resolveNeighbors(orderedIds);

    return stories.map((story) => {
        const { previous, next } = neighbors[story.id] ?? {
            previous: null,
            next: null
        };

        return {
            params: { id: story.id },
            props: {
                story,
                historiaAnterior: previous
                    ? storiesById.get(previous)
                    : undefined,
                historiaSiguiente: next ? storiesById.get(next) : undefined
            }
        };
    });
}

type Props = {
    story: CollectionEntry<"stories">;
    historiaAnterior?: CollectionEntry<"stories">;
    historiaSiguiente?: CollectionEntry<"stories">;
};

const { story, historiaAnterior, historiaSiguiente } = Astro.props;
const { Content } = await render(story);
const base = import.meta.env.BASE_URL;
const imagen = getStoryImage(story.id);
---

<BaseLayout
    title={`${story.data.title} | Mistorias`}
    description={story.data.summary}
>
    <article class="historia">
        <header class="columna historia__cabecera">
            <h1>{story.data.title}</h1>

            <p class="historia__metadatos">
                Por {story.data.author}
                <span aria-hidden="true">·</span>
                <time datetime={dateForAttribute(story.data.date)}>
                    {readableDate(story.data.date)}
                </time>
            </p>

            <p class="historia__resumen">{story.data.summary}</p>
        </header>

        {
            // El gate de contenido (story-image-requirements.ts) exige
            // imageAlt siempre que exista principal.jpg: si `imagen` está
            // presente, `imageAlt` también, por construcción.
            imagen && (
                <figure class="columna historia__imagen">
                    <span class="historia__marcador">
                        <SimboloMistorias />
                    </span>
                    <Picture
                        src={imagen}
                        alt={story.data.imageAlt!}
                        width={1200}
                        formats={["webp"]}
                        fallbackFormat="jpg"
                        loading="lazy"
                        class="historia__foto"
                    />
                    <figcaption class="historia__credito">
                        {story.data.imageCredit}
                        <span aria-hidden="true">·</span>
                        {story.data.imageLicense}
                    </figcaption>
                </figure>
            )
        }

        {/* La prosa recibe un solo tratamiento tipográfico: el esquema no
            garantiza qué secciones trae una historia, así que el diseño no se
            acopla a sus títulos. */}
        <div class="columna prosa">
            <Content />
        </div>

        <p class="columna historia__aviso">
            Los personajes de esta historia son ficticios; cualquier parecido
            con personas reales es pura coincidencia.
        </p>

        {
            (story.data.themes ?? []).length > 0 && (
                <footer class="columna historia__pie">
                    <h2 class="historia__pie-titulo">Temas relacionados</h2>
                    <ListaTemas
                        temas={story.data.themes ?? []}
                        temaTextual="Temas de esta historia"
                    />
                    <p class="historia__explorar">
                        <a href={themesRoute(base)}>Explorar otros temas</a>
                    </p>
                </footer>
            )
        }

        <NavegacionHistorias
            historiaAnterior={historiaAnterior}
            historiaSiguiente={historiaSiguiente}
        />
    </article>
</BaseLayout>

<style>
    .historia {
        padding-block-start: var(--esp-xl);
    }

    .historia__cabecera {
        padding-block-end: var(--esp-l);
        border-block-end: 1px solid var(--color-borde);
        margin-block-end: var(--esp-l);
    }

    /* Flex con `gap` en vez de espacios en el marcado: el compilador colapsa la
       plantilla y el separador quedaba pegado a la autoría y a la fecha. */
    .historia__metadatos {
        display: flex;
        flex-wrap: wrap;
        gap: 0 0.6ch;
        margin-block-start: var(--esp-s);
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        color: var(--color-metadato);
    }

    /* Mismo patrón que TarjetaHistoria.astro: el símbolo va detrás de la
       foto y con shimmer mientras `loading="lazy"` todavía no la trae —
       cero JS, el navegador la tapa solo al pintar encima. Acá siempre hay
       imagen (el bloque entero no se renderiza si no la hay), así que el
       shimmer se aplica sin condición. `prefers-reduced-motion` ya lo cubre
       la regla global de base.css. */
    .historia__imagen {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: var(--radio);
        background-color: var(--color-superficie);
        margin-block-end: var(--esp-l);
    }

    .historia__marcador {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--paso-3);
        color: var(--color-borde);
        background-image: linear-gradient(
            110deg,
            transparent 35%,
            color-mix(in srgb, var(--color-acento) 25%, transparent) 50%,
            transparent 65%
        );
        background-size: 200% 100%;
        animation: historia-marcador-shimmer 1.6s ease-in-out infinite;
    }

    @keyframes historia-marcador-shimmer {
        from {
            background-position: 150% 0;
        }
        to {
            background-position: -50% 0;
        }
    }

    .historia__foto {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* El pie de foto se lee sobre una fotografía arbitraria, no sobre el
       fondo de la página: por eso usa blanco fijo en vez de un token de
       superficie, que en tema oscuro no garantizaría contraste contra la
       imagen de abajo. */
    .historia__credito {
        position: absolute;
        inset-block-end: 0;
        inset-inline: 0;
        padding: var(--esp-xs) var(--esp-s);
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        color: #fff;
        background: linear-gradient(to top, rgb(0 0 0 / 60%), transparent);
    }

    .historia__resumen {
        margin-block-start: var(--esp-m);
        font-size: var(--paso-1);
        font-style: italic;
        color: var(--color-analitico);
    }

    .historia__aviso {
        padding-block-start: var(--esp-m);
        margin-block-start: var(--esp-l);
        border-block-start: 1px solid var(--color-borde);
        font-size: var(--paso--1);
        font-style: italic;
        color: var(--color-metadato);
    }

    .historia__pie {
        padding-block-start: var(--esp-l);
        margin-block-start: var(--esp-xl);
        border-block-start: 1px solid var(--color-borde);
    }

    /* Quien termina de leer no necesariamente quiere otro texto sobre lo
       mismo: el enlace abre el índice completo, no solo estos temas. */
    .historia__explorar {
        margin-block-start: var(--esp-m);
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
    }

    .historia__pie-titulo {
        margin-block-end: var(--esp-xs);
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-metadato);
    }
</style>
