---
// Página de opinión de una historia (issue #42 de gestión de producto): una
// calificación de 1 a 5 más un texto libre opcional, en su propia URL en vez
// de un widget al pie de la historia. Mismo patrón que "Reportar un
// problema" —una página con formulario en vez de un correo o un bloque
// incrustado (Smashing Magazine)— y mismo principio de Typeform: una sola
// pregunta protagonista (la calificación), el texto libre queda claramente
// secundario y opcional, y la copia es breve y personal, no una encuesta.
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AvisoSoloNetlify from "../../../components/AvisoSoloNetlify.astro";
import { gratitudeRoute, storyRoute } from "../../../lib/routes";

export async function getStaticPaths() {
    const stories = await getCollection("stories");

    return stories.map((story) => ({
        params: { id: story.id },
        props: { story }
    }));
}

type Props = {
    story: CollectionEntry<"stories">;
};

const { story } = Astro.props;
const base = import.meta.env.BASE_URL;
const accion = gratitudeRoute(base);
const escala = [1, 2, 3, 4, 5] as const;
---

<BaseLayout
    title={`Tu opinión sobre «${story.data.title}» — Mistorias`}
    description="Tu opinión decide qué mejoramos en las siguientes historias."
>
    <div class="columna opinar">
        <p class="opinar__volver">
            <a href={storyRoute(base, story.id)}>&larr; Volver a la historia</a
            >
        </p>

        <h1>¿Qué te pareció esta historia?</h1>

        <p class="opinar__gancho">
            Tu opinión sobre «{story.data.title}» decide qué mejoramos en las
            siguientes. Toma menos de un minuto.
        </p>

        <AvisoSoloNetlify>
            Estás viendo la versión de trabajo del sitio, publicada en GitHub
            Pages: este formulario solo llega cuando se envía desde
            mistorias.pe.
        </AvisoSoloNetlify>

        <form
            class="opinar__formulario"
            name="opinion-historia"
            method="POST"
            data-netlify="true"
            netlify-honeypot="opinion-empresa"
            action={accion}
        >
            <input type="hidden" name="form-name" value="opinion-historia" />
            <input type="hidden" name="historia" value={story.id} />

            <p class="opinar__oculto" aria-hidden="true">
                <label>
                    No llenes este campo si eres una persona:
                    <input
                        tabindex="-1"
                        autocomplete="off"
                        name="opinion-empresa"
                    />
                </label>
            </p>

            <fieldset class="opinar__calificacion">
                <legend>Calificación</legend>

                <div class="opinar__escala">
                    <span>Nada útil</span>
                    <span>Muy útil</span>
                </div>

                <div class="opinar__opciones">
                    {
                        escala.map((valor) => (
                            <label class="opinar__opcion">
                                <input
                                    type="radio"
                                    name="calificacion"
                                    value={valor}
                                    required
                                />
                                <span>{valor}</span>
                            </label>
                        ))
                    }
                </div>
            </fieldset>

            <p class="opinar__campo">
                <label for="opinar-comentario">
                    Cuéntanos más (opcional)
                </label>
                <textarea
                    id="opinar-comentario"
                    name="comentario"
                    rows="4"
                    placeholder="Qué te gustó o qué podríamos mejorar"
                ></textarea>
            </p>

            <button type="submit">Enviar opinión</button>
        </form>
    </div>
</BaseLayout>

<style>
    .opinar {
        padding-block: var(--esp-xl);
    }

    .opinar__volver {
        margin-block-end: var(--esp-l);
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
    }

    .opinar__gancho {
        max-width: var(--medida);
        margin-block-start: var(--esp-s);
        font-size: var(--paso-1);
        color: var(--color-analitico);
    }

    .opinar__formulario {
        display: grid;
        gap: var(--esp-m);
        margin-block: var(--esp-l);
    }

    /* Campo trampa contra bots: solo lo rellenan scripts que no ejecutan CSS
       ni distinguen `display: none` de un campo real, así que a cualquier
       persona —con o sin lector de pantalla— nunca le aparece. */
    .opinar__oculto {
        display: none;
    }

    .opinar__calificacion {
        padding: 0;
        border: none;
    }

    .opinar__calificacion legend {
        padding: 0;
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
        color: var(--color-texto);
    }

    .opinar__escala {
        display: flex;
        justify-content: space-between;
        max-width: 16rem;
        margin-block-start: var(--esp-2xs);
        font-size: var(--paso--1);
        color: var(--color-metadato);
    }

    .opinar__opciones {
        display: flex;
        flex-wrap: wrap;
        gap: var(--esp-s);
        margin-block-start: var(--esp-2xs);
    }

    .opinar__opcion {
        display: inline-flex;
        align-items: center;
        gap: var(--esp-3xs);
        min-height: 44px;
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
    }

    .opinar__campo {
        display: grid;
        gap: var(--esp-2xs);
    }

    .opinar__campo label {
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
        color: var(--color-texto);
    }

    .opinar__campo textarea {
        padding: var(--esp-xs) var(--esp-s);
        border: 1px solid var(--color-borde);
        border-radius: var(--radio);
        background-color: var(--color-superficie);
        color: var(--color-texto);
        font: inherit;
        font-size: var(--paso--1);
        resize: vertical;
    }

    .opinar__formulario button {
        justify-self: start;
        min-height: 44px;
        padding-inline: var(--esp-m);
        border: none;
        border-radius: var(--radio);
        background-color: var(--color-acento);
        color: var(--color-superficie);
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
        cursor: pointer;
    }

    @media (hover: hover) {
        .opinar__formulario button:hover {
            opacity: 0.9;
        }
    }
</style>
