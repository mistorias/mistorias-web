---
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource-variable/lora";
import "../styles/tokens.css";
import "../styles/base.css";
import loraLatino from "@fontsource-variable/lora/files/lora-latin-wght-normal.woff2?url";

import type { ImageMetadata } from "astro";
import CabeceraSitio from "../components/CabeceraSitio.astro";
import PieSitio from "../components/PieSitio.astro";
import { assetRoute } from "../lib/routes";
import { isDevelopmentTarget } from "../lib/deployment";
import { defaultOgImage, ogImageFromStoryImage } from "../lib/social/og-image";

// GitHub Pages no permite configurar cabeceras HTTP, así que la CSP viaja en
// un <meta>. Es la única barrera disponible en el entorno de desarrollo; en
// producción, `public/_headers` la envía además como cabecera junto con
// frame-ancestors y HSTS, que un <meta> no puede expresar.
//
// Las tipografías son propias y se sirven desde el mismo origen, así que caen
// bajo `default-src 'self'` y no hizo falta relajar ninguna directiva.
//
// `form-action` es la excepción: los formularios de feedback (issue #42 de
// gestión de producto) usan Netlify Forms sin JavaScript, así que el propio
// HTML hace un POST normal a la página donde vive el formulario. 'self' basta
// —nunca se postea a otro origen— y sigue bloqueando cualquier envío externo.
const contentSecurityPolicy = [
    "default-src 'self'",
    "img-src 'self' data:",
    "style-src 'self' 'unsafe-inline'",
    "script-src 'none'",
    "object-src 'none'",
    "base-uri 'self'",
    "form-action 'self'"
].join("; ");

type Props = {
    title: string;
    description?: string;
    ogImage?: { src: ImageMetadata; alt: string };
};

const { title, description, ogImage } = Astro.props;

// El build de desarrollo antepone "WIP: " para que no se confunda con el
// sitio real (issue #28).
const esDesarrollo = isDevelopmentTarget(process.env.DEPLOY_TARGET);
const tituloMostrado = esDesarrollo ? `WIP: ${title}` : title;

// Los iconos viven en `public/` y se sirven tal cual, así que su ruta depende
// de la base del despliegue igual que cualquier enlace interno. El navegador
// solo busca `/favicon.ico` en la raíz del dominio por su cuenta: en GitHub
// Pages, donde el sitio cuelga de `/mistorias-web`, sin estas etiquetas no
// encuentra ninguno.
const base = import.meta.env.BASE_URL;
const iconos = {
    ico: assetRoute(base, "favicon.ico"),
    png16: assetRoute(base, "favicon-16x16.png"),
    png32: assetRoute(base, "favicon-32x32.png"),
    png48: assetRoute(base, "favicon-48x48.png"),
    apple: assetRoute(base, "apple-touch-icon.png"),
    manifiesto: assetRoute(base, "site.webmanifest")
};

const urlCanonica = Astro.site
    ? new URL(Astro.url.pathname, Astro.site)
    : undefined;

// La cabecera 16:9 de la historia (recortada a 1200×630) si la hay, o si no
// la ilustración de portada pre-generada (issue #39): toda página emite un
// og:image, nunca queda en blanco al compartirse.
const imagenOg = ogImage
    ? await ogImageFromStoryImage(ogImage.src, ogImage.alt)
    : defaultOgImage(base);

// Igual que urlCanonica: sin Astro.site (fuera de un build real, como los
// tests de este componente) no hay origen contra el cual armar una URL
// absoluta, y og:image la necesita absoluta para que Facebook y X puedan
// buscarla.
const urlImagenOg = Astro.site
    ? new URL(imagenOg.src, Astro.site).toString()
    : undefined;
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <meta name="color-scheme" content="light dark" />

    <title>{tituloMostrado}</title>
    {description && <meta name="description" content={description} />}
    {urlCanonica && <link rel="canonical" href={urlCanonica} />}

    <!-- GitHub Pages sirve este build bajo /mistorias-web, no en la raíz del
         origen: un crawler solo lee robots.txt en mistorias.github.io/robots.txt
         (de otro repo), así que el Disallow de src/lib/seo/robots.ts nunca
         llega a leerse ahí. La única barrera que sí opera bajo un subpath es
         esta etiqueta por página — mismo destino que el marcador "WIP:" de
         arriba (issue #28, ADR 0015). -->
    {esDesarrollo && <meta name="robots" content="noindex, nofollow" />}

    <!-- El .ico trae 16, 32 y 48 para los navegadores que solo leen ese
         formato; los PNG son para los que prefieren mapa de bits. El
         manifiesto declara los iconos de Android y el color de la marca. -->
    <link rel="icon" href={iconos.ico} sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href={iconos.png16} />
    <link rel="icon" type="image/png" sizes="32x32" href={iconos.png32} />
    <link rel="icon" type="image/png" sizes="48x48" href={iconos.png48} />
    <link rel="apple-touch-icon" sizes="180x180" href={iconos.apple} />
    <link rel="manifest" href={iconos.manifiesto} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content="Mistorias" />
    <meta property="og:title" content={tituloMostrado} />
    {description && <meta property="og:description" content={description} />}
    {urlCanonica && <meta property="og:url" content={urlCanonica} />}
    {
        urlImagenOg && (
            <>
                <meta property="og:image" content={urlImagenOg} />
                <meta property="og:image:width" content={String(imagenOg.width)} />
                <meta property="og:image:height" content={String(imagenOg.height)} />
                <meta property="og:image:alt" content={imagenOg.alt} />
                <meta name="twitter:card" content="summary_large_image" />
            </>
        )
    }

    <!-- La fuente narrativa es la que bloquea la lectura: se precarga solo el
         subconjunto latino, que es el único que el castellano necesita. -->
    <link
        rel="preload"
        as="font"
        type="font/woff2"
        href={loraLatino}
        crossorigin
    />
</head>

<body>
<a class="salto-contenido" href="#contenido">Saltar al contenido</a>

<CabeceraSitio />

<main id="contenido" tabindex="-1">
    <slot />
</main>

<PieSitio />
</body>
</html>
