---
// Feedback al cierre de cada historia (issue #42 de gestión de producto): una
// calificación de 1 a 5 —clic, sin escribir nada— más un campo de texto
// opcional para quien quiera contar qué le gustó o qué podría mejorar. Un solo
// campo libre y no dos (uno por pregunta): la calificación ya separa a quien
// solo quiere dejar una señal rápida de quien quiere elaborar, así que pedir
// dos textos distintos habría sido fricción de más para el mismo dato.
//
// Vive en la propia historia, no en una página aparte: se probó una página
// por historia (`/historias/<id>/opinar/`) y se descartó — duplicaba el
// número de páginas del sitio sin necesidad, cuando calificar sin salir de
// la lectura es igual de simple y no rompe el hilo de haber terminado de
// leer. El nombre de la historia no aparece en la pregunta: quien lo ve ya
// está leyéndola, repetirlo no suma nada a la decisión de calificar.
//
// Mismo mecanismo que "Reportar un problema": Netlify Forms sin JavaScript,
// un formulario por historia identificado con un campo oculto.
//
// El comentario puede ser anónimo (queda privado, solo lo lee el equipo) o
// público con nombre (ADR 0036): elegir "público" es el consentimiento expreso
// que pide la Ley 29733. La calificación nunca se publica por separado. Que
// nombre y comentario sean obligatorios para publicar lo valida la función de
// Netlify, no el navegador: un envío público incompleto queda como opinión
// privada en vez de perderse.
import AvisoSoloNetlify from "./AvisoSoloNetlify.astro";
import { gratitudeRoute, reportRoute } from "../lib/routes";

type Props = {
    historiaId: string;
};

const { historiaId } = Astro.props;
const base = import.meta.env.BASE_URL;
const formAction = gratitudeRoute(base);
const reportHref = reportRoute(base);

// El punto crece con el valor (14px→30px) y su borde se acerca al acento de
// marca a la misma velocidad (20%→100%): tamaño y color cuentan la misma
// historia — de "nada útil" a "muy útil" — antes de que se lea un número.
const scale = [1, 2, 3, 4, 5].map((value) => ({
    value,
    size: 10 + value * 4,
    intensity: value * 20
}));
---

<section class="columna opinion-historia">
    <h2 class="opinion-historia__titulo">¿Qué te pareció esta historia?</h2>
    <p class="opinion-historia__gancho">
        Con un clic nos ayudas a mejorar las próximas.
    </p>

    <AvisoSoloNetlify>
        Estás viendo la versión de trabajo del sitio, publicada en GitHub
        Pages: este formulario solo llega cuando se envía desde mistorias.pe.
    </AvisoSoloNetlify>

    <form
        class="opinion-historia__formulario"
        name="opinion-historia"
        method="POST"
        data-netlify="true"
        netlify-honeypot="opinion-empresa"
        action={formAction}
    >
        <input type="hidden" name="form-name" value="opinion-historia" />
        <input type="hidden" name="historia" value={historiaId} />

        <p class="opinion-historia__oculto" aria-hidden="true">
            <label>
                Empresa
                <input tabindex="-1" autocomplete="off" name="opinion-empresa" />
            </label>
        </p>

        <fieldset class="opinion-historia__calificacion">
            <legend>Calificación</legend>

            <div class="opinion-historia__escala">
                <span>Nada útil</span>
                <span>Muy útil</span>
            </div>

            <div class="opinion-historia__opciones">
                {
                    scale.map(({ value, size, intensity }) => (
                        <label
                            class="opinion-historia__opcion"
                            style={`--tamano: ${size}px; --intensidad: ${intensity}%`}
                        >
                            <input
                                type="radio"
                                name="calificacion"
                                value={value}
                                required
                                aria-label={`Calificar ${value} de 5`}
                            />
                            <span class="opinion-historia__punto" aria-hidden="true" />
                            <span class="opinion-historia__numero" aria-hidden="true">
                                {value}
                            </span>
                        </label>
                    ))
                }
            </div>

            <p class="opinion-historia__nota">
                Tu calificación nunca se publica de forma individual: solo
                cuenta para el promedio.
            </p>
        </fieldset>

        <p class="opinion-historia__campo">
            <label for={`opinion-comentario-${historiaId}`}>
                Cuéntanos más (opcional)
            </label>
            <textarea
                id={`opinion-comentario-${historiaId}`}
                name="comentario"
                rows="4"
                maxlength="1500"
                placeholder="Qué te gustó o qué podríamos mejorar"
            ></textarea>
        </p>

        <fieldset class="opinion-historia__visibilidad">
            <legend>¿Quién puede leer tu comentario?</legend>

            <label class="opinion-historia__eleccion">
                <input type="radio" name="visibilidad" value="anonimo" checked />
                <span>Solo el equipo de Mistorias. Es anónimo y no se publica</span>
            </label>
            <label class="opinion-historia__eleccion">
                <input type="radio" name="visibilidad" value="publico" />
                <span>Todos: publícalo bajo la historia con mi nombre</span>
            </label>
        </fieldset>

        {/* Se oculta con `:has` mientras esté marcada la opción anónima; un
            navegador sin `:has` lo deja siempre visible, que es lo seguro. */}
        <div class="opinion-historia__publico">
            <p class="opinion-historia__campo">
                <label for={`opinion-nombre-${historiaId}`}>Tu nombre</label>
                <input
                    id={`opinion-nombre-${historiaId}`}
                    name="nombre"
                    type="text"
                    maxlength="60"
                    autocomplete="name"
                />
            </p>

            <p class="opinion-historia__nota">
                Para publicarlo necesitamos tu nombre y tu comentario. Los
                comentarios con enlaces o correos no se publican. Lo revisamos
                en público, en GitHub: mientras tanto se verá ahí y ese
                registro no se puede borrar. Para retirarlo después, escríbenos
                desde <a href={reportHref}>Reportar un problema</a>.
            </p>
        </div>

        <button type="submit">Enviar opinión</button>
    </form>
</section>

<style>
    .opinion-historia {
        padding-block-start: var(--esp-l);
        margin-block-start: var(--esp-xl);
        border-block-start: 1px solid var(--color-borde);
    }

    .opinion-historia__titulo {
        font-size: var(--paso-1);
    }

    .opinion-historia__gancho {
        margin-block-start: var(--esp-2xs);
        color: var(--color-analitico);
    }

    .opinion-historia__formulario {
        display: grid;
        gap: var(--esp-m);
        margin-block-start: var(--esp-m);
    }

    /* Campo trampa contra bots: solo lo rellenan scripts que no ejecutan CSS
       ni distinguen `display: none` de un campo real, así que a cualquier
       persona —con o sin lector de pantalla— nunca le aparece. La etiqueta
       ("Empresa") es deliberadamente genérica y no una advertencia tipo "no
       llenes esto": un bot que lee el texto en vez de solo la forma del
       campo no tiene por qué reconocerlo como trampa. */
    .opinion-historia__oculto {
        display: none;
    }

    .opinion-historia__calificacion {
        padding: 0;
        border: none;
    }

    .opinion-historia__calificacion legend {
        padding: 0;
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
        color: var(--color-texto);
    }

    /* La escala y los puntos comparten el mismo ancho y el mismo
       `space-between`: es lo que hace que "Muy útil" y el punto del 5
       terminen exactamente en el mismo borde derecho, sin un número mágico
       repetido en dos sitios. Más ancho que antes (era 16rem) a propósito:
       es el "más espacio entre los valores" que se pidió — `space-between`
       reparte ese ancho extra entre los puntos, no hace falta un `gap`. */
    .opinion-historia__escala,
    .opinion-historia__opciones {
        display: flex;
        justify-content: space-between;
        max-width: 22rem;
    }

    .opinion-historia__escala {
        margin-block-start: var(--esp-2xs);
        font-size: var(--paso--1);
        color: var(--color-metadato);
    }

    .opinion-historia__opciones {
        margin-block-start: var(--esp-s);
    }

    /* Un solo clic activa el radio en cualquier punto del label —así lo
       resuelve `<label>` de forma nativa—, así que el input real no
       necesita ocupar espacio visual: 1px, fuera del flujo, siempre
       enfocable por teclado. El punto y el número son los que se ven. */
    .opinion-historia__opcion {
        position: relative;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
        gap: var(--esp-3xs);
        min-width: 44px;
        min-height: 44px;
        justify-content: center;
        font-family: var(--fuente-info);
        cursor: pointer;
    }

    .opinion-historia__opcion input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
    }

    /* Casilla de tamaño fijo (el punto más grande, el del 5, la define) para
       que los cinco puntos —de diámetro distinto— centren su círculo sobre
       el mismo eje horizontal en vez de compartir solo el borde superior. */
    .opinion-historia__punto {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
    }

    .opinion-historia__punto::after {
        content: "";
        width: var(--tamano);
        height: var(--tamano);
        border-radius: 50%;
        /* El borde se acerca al acento a la misma velocidad que crece el
           punto: la escala se lee en color además de en tamaño antes de
           fijarse en el número. */
        border: 2px solid
            color-mix(in srgb, var(--color-acento) var(--intensidad), var(--color-borde));
        background-color: transparent;
        transition: transform 0.15s ease, background-color 0.15s ease;
    }

    .opinion-historia__opcion input:checked ~ .opinion-historia__punto::after {
        background-color: var(--color-acento);
        border-color: var(--color-acento);
    }

    .opinion-historia__numero {
        font-size: var(--paso--1);
        color: var(--color-metadato);
    }

    .opinion-historia__opcion input:checked ~ .opinion-historia__numero {
        font-weight: 600;
        color: var(--color-acento);
    }

    /* El input real está en `opacity: 0`, así que su propio foco (la regla
       global de base.css) es invisible; se redirige al punto, que además
       gana su propio radio de foco en vez del cuadrado por defecto. */
    .opinion-historia__opcion input:focus-visible ~ .opinion-historia__punto::after {
        outline: var(--grosor-foco) solid var(--color-vivo);
        outline-offset: 3px;
        border-radius: 50%;
    }

    @media (hover: hover) {
        .opinion-historia__opcion:hover .opinion-historia__punto::after {
            transform: scale(1.15);
        }
    }

    .opinion-historia__campo {
        display: grid;
        gap: var(--esp-2xs);
    }

    .opinion-historia__campo label {
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
        color: var(--color-texto);
    }

    .opinion-historia__campo textarea,
    .opinion-historia__campo input {
        padding: var(--esp-xs) var(--esp-s);
        border: 1px solid var(--color-borde);
        border-radius: var(--radio);
        background-color: var(--color-superficie);
        color: var(--color-texto);
        font: inherit;
        font-size: var(--paso--1);
        resize: vertical;
    }

    .opinion-historia__campo input {
        min-height: 44px;
    }

    .opinion-historia__nota {
        margin-block-start: var(--esp-2xs);
        font-size: var(--paso--1);
        color: var(--color-metadato);
    }

    .opinion-historia__visibilidad {
        display: grid;
        gap: var(--esp-2xs);
        padding: 0;
        border: none;
    }

    .opinion-historia__visibilidad legend {
        padding: 0;
        margin-block-end: var(--esp-2xs);
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
        color: var(--color-texto);
    }

    /* Cada opción es un `label` entero: toda la fila se puede tocar y mide al
       menos 44px de alto. El radio es el nativo, así que el teclado y el foco
       visible (regla global de base.css) funcionan sin trabajo extra. */
    .opinion-historia__eleccion {
        display: flex;
        align-items: flex-start;
        gap: var(--esp-xs);
        min-height: 44px;
        font-size: var(--paso--1);
        cursor: pointer;
    }

    .opinion-historia__eleccion input {
        flex: none;
        width: 1.25rem;
        height: 1.25rem;
        margin-block: 0.6rem 0;
        accent-color: var(--color-acento);
    }

    .opinion-historia__eleccion span {
        align-self: center;
    }

    .opinion-historia__publico {
        display: grid;
        gap: var(--esp-2xs);
    }

    .opinion-historia__formulario:has([value="anonimo"]:checked)
        .opinion-historia__publico {
        display: none;
    }

    .opinion-historia__formulario button {
        justify-self: start;
        min-height: 44px;
        padding-inline: var(--esp-m);
        border: none;
        border-radius: var(--radio);
        background-color: var(--color-acento);
        color: var(--color-superficie);
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
        cursor: pointer;
    }

    @media (hover: hover) {
        .opinion-historia__formulario button:hover {
            opacity: 0.9;
        }
    }
</style>
