---
import { themeRoute } from "../lib/routes";

type Props = {
    temas: readonly string[];
    temaTextual: string;
};

const { temas, temaTextual } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul class="temas" role="list" aria-label={temaTextual}>
    {
        temas.map((tema) => (
            <li>
                <a class="temas__ficha" href={themeRoute(base, tema)}>
                    {tema}
                </a>
            </li>
        ))
    }
</ul>

<style>
    .temas {
        display: flex;
        flex-wrap: wrap;
        gap: var(--esp-2xs);
        padding: 0;
        list-style: none;
    }

    .temas__ficha {
        /* 44px de blanco de toque: en celular vertical las fichas son lo más
           difícil de acertar con el pulgar. */
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding-inline: var(--esp-xs);
        border: 1px solid var(--color-borde);
        border-radius: var(--radio);
        background-color: var(--color-realce);
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        color: var(--color-metadato);
        text-decoration: none;
    }

    @media (hover: hover) {
        .temas__ficha:hover {
            border-color: var(--color-vivo);
            color: var(--color-acento);
        }
    }
</style>
