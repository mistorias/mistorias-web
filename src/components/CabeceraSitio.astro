---
import LogotipoMistorias from "./LogotipoMistorias.astro";
import { aboutRoute, homeRoute } from "../lib/routes";

const base = import.meta.env.BASE_URL;
const inicio = homeRoute(base);
const acerca = aboutRoute(base);

// La navegación tiene un solo destino, así que entra en línea desde 320px. Que
// no haga falta un menú desplegable es afortunado: exigiría JavaScript y la CSP
// del sitio declara `script-src 'none'`.
const esRutaActual = (ruta: string) => Astro.url.pathname === ruta;
---

<header class="cabecera">
    <div class="contenedor cabecera__interior">
        <a
            class="cabecera__marca"
            href={inicio}
            aria-current={esRutaActual(inicio) ? "page" : undefined}
        >
            <LogotipoMistorias disposicion="adaptable" />
        </a>

        <nav aria-label="Principal">
            <a
                class="cabecera__enlace"
                href={acerca}
                aria-current={esRutaActual(acerca) ? "page" : undefined}
            >
                Acerca de
            </a>
        </nav>
    </div>
</header>

<style>
    .cabecera {
        border-block-end: 1px solid var(--color-borde);
        background-color: var(--color-superficie);
    }

    .cabecera__interior {
        display: flex;
        flex-wrap: wrap;
        gap: var(--esp-s);
        align-items: center;
        justify-content: space-between;
        padding-block: var(--esp-s);
    }

    /*
     * El tamaño del logotipo es el `--paso-1` de siempre: reutiliza la
     * escala del sistema en vez de un `clamp()` propio. En pantalla vertical
     * el logotipo va apilado (palabra + símbolo debajo, ver
     * LogotipoMistorias) y la cabecera crece; en celular horizontal
     * (`max-height: 30rem`) baja a `--paso-0` y pasa a fila, para que el
     * blanco de toque de 44px del enlace de navegación siga siendo lo que
     * fija el alto de la cabecera en 75px.
     */
    .cabecera__marca {
        font-size: var(--paso-1);
        text-decoration: none;
    }

    @media (max-height: 30rem) {
        .cabecera__marca {
            font-size: var(--paso-0);
        }
    }

    .cabecera__enlace {
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
        color: var(--color-texto);
        text-decoration: none;
        /* Blanco de toque cómodo para el pulgar en celular. */
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding-inline: var(--esp-2xs);
    }

    .cabecera__enlace[aria-current="page"] {
        color: var(--color-acento);
        text-decoration: underline;
        text-decoration-thickness: 0.14em;
        text-underline-offset: 0.25em;
    }

    @media (hover: hover) {
        /* La palabra vive en LogotipoMistorias: :global() alcanza su clase
           sin que Astro exija además el ámbito de este componente. */
        .cabecera__marca:hover :global(.logotipo__palabra) {
            text-decoration: underline;
            text-underline-offset: 0.25em;
        }

        .cabecera__enlace:hover {
            text-decoration: underline;
            text-underline-offset: 0.25em;
        }
    }
</style>
