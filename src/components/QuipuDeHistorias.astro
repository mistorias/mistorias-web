---
import type { CollectionEntry } from "astro:content";
import NudoDeQuipu from "./NudoDeQuipu.astro";
import ResumenDeQuipu from "./ResumenDeQuipu.astro";
import type { Rounding } from "./NudoDeQuipu.astro";
import type { TimelineYear } from "../lib/weeks";
import { readableWeekRange } from "../lib/dates";
import { storyRoute } from "../lib/routes";
import { countStories } from "../lib/stories";

type Props = {
    anos: readonly TimelineYear<CollectionEntry<"stories">>[];
};

const { anos } = Astro.props;
const base = import.meta.env.BASE_URL;

/*
 * El redondeo de cada tramo depende de su posición en la lista de semanas
 * del año, no de qué tipo de entrada es: la primera fila del año redondea
 * arriba (linda con el resumen), la última redondea abajo (linda con el
 * siguiente año), las del medio quedan rectas, y si el año tiene una sola
 * entrada, esa entrada es primera y última a la vez.
 */
const roundingFor = (index: number, total: number): Rounding => {
    const isFirst = index === 0;
    const isLast = index === total - 1;
    if (isFirst && isLast) return "ambos";
    if (isFirst) return "arriba";
    if (isLast) return "abajo";
    return "ninguno";
};
---

<ol class="quipu-anos">
    {
        anos.map((timelineYear, index) => (
            // El año abierto es el primero de la lista, no el año calendario
            // actual: buildTimeline (src/lib/weeks.ts) ya entrega los años en
            // orden descendente, así que el índice 0 es siempre el más
            // reciente del contenido. Es el mismo criterio de determinismo
            // que usa el propio buildTimeline para anclar el rango.
            <li>
                <details open={index === 0}>
                    <ResumenDeQuipu
                        titulo={String(timelineYear.year)}
                        cuenta={countStories(timelineYear.storyCount)}
                    />
                    <ol class="quipu-semanas">
                        {
                            timelineYear.entries.map((entry, entryIndex) => {
                                const rounding = roundingFor(
                                    entryIndex,
                                    timelineYear.entries.length
                                );

                                return entry.kind === "gap" ? (
                                    // Hueco colapsado (3+ semanas seguidas sin
                                    // historia, GAP_THRESHOLD en weeks.ts):
                                    // cuerda sólida sin nudos, con el texto
                                    // visible al lado.
                                    <li class="quipu-hueco">
                                        <span class="quipu-semana__cuerda">
                                            <NudoDeQuipu
                                                cantidad={0}
                                                redondeo={rounding}
                                            />
                                        </span>
                                        <p class="quipu-hueco__texto">
                                            {entry.weeks} semanas sin historia
                                        </p>
                                    </li>
                                ) : entry.stories.length === 0 ? (
                                    // Semana sin historia: cuerda sólida sin
                                    // nudos — es el cero del quipu, ausencia y
                                    // no un símbolo aparte. aria-hidden porque
                                    // no aporta nada navegable y ensuciaría el
                                    // recorrido de quien usa lector de
                                    // pantalla.
                                    <li
                                        class="quipu-semana quipu-semana--vacia"
                                        aria-hidden="true"
                                    >
                                        <span class="quipu-semana__cuerda">
                                            <NudoDeQuipu
                                                cantidad={0}
                                                redondeo={rounding}
                                            />
                                        </span>
                                        <div class="quipu-semana__contenido" />
                                    </li>
                                ) : (
                                    <li class="quipu-semana">
                                        <span class="quipu-semana__cuerda">
                                            <NudoDeQuipu
                                                cantidad={entry.stories.length}
                                                redondeo={rounding}
                                            />
                                        </span>
                                        <div class="quipu-semana__contenido">
                                            <h3>
                                                <time datetime={entry.key}>
                                                    Semana{" "}
                                                    {readableWeekRange(
                                                        entry.start,
                                                        entry.end
                                                    )}
                                                </time>
                                            </h3>
                                            <ul class="quipu-historias">
                                                {entry.stories.map((story) => (
                                                    <li>
                                                        <a
                                                            href={storyRoute(
                                                                base,
                                                                story.id
                                                            )}
                                                        >
                                                            {story.data.title}
                                                        </a>
                                                        <p>{story.data.summary}</p>
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    </li>
                                );
                            })
                        }
                    </ol>
                </details>
            </li>
        ))
    }
</ol>

<style>
    /*
     * `var(--medida)` y no un ancho a mano: es la misma medida de lectura
     * (65ch) que usa el resto del sitio.
     */
    .quipu-anos {
        list-style: none;
        margin: 0;
        padding: 0;
        max-width: var(--medida);
    }

    .quipu-anos > li + li {
        margin-block-start: var(--esp-l);
    }

    .quipu-semanas {
        list-style: none;
        margin: var(--esp-s) 0 0;
        padding: 0;
    }

    .quipu-semana {
        display: grid;
        grid-template-columns: 1.25rem 1fr;
        column-gap: var(--esp-s);
    }

    /*
     * Sin margen entre filas: los tramos de cuerda de cada fila se tocan sin
     * espacio y así se leen como una cuerda continua, no como piezas
     * apiladas. `NudoDeQuipu` resuelve el redondeo de cada tramo según su
     * posición (primera, última, del medio) justamente para que este
     * contacto sin margen no deje una hendidura visible.
     */
    .quipu-semana + .quipu-semana {
        margin-block-start: 0;
    }

    .quipu-semana__cuerda {
        grid-column: 1;
        color: var(--color-metadato);
    }

    .quipu-semana__contenido {
        grid-column: 2;
        min-width: 0;
        padding-block: var(--esp-2xs) 0;
    }

    /*
     * `--fuente-info` en vez del Lora que trae h3 por defecto (base.css): el
     * rótulo de semana es navegación/metadato, no narrativa — mismo criterio
     * que separa `--fuente-info` (información) de `--fuente-narrativa`
     * (historias) en identidad-visual.md. El título de la historia, que sí es
     * contenido editorial, se deja en el Lora que trae por herencia.
     */
    .quipu-semana__contenido h3 {
        margin: 0 0 var(--esp-2xs);
        font-family: var(--fuente-info);
        font-size: var(--paso-0);
        font-weight: 600;
        color: var(--color-texto);
    }

    .quipu-historias {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: var(--esp-2xs);
    }

    .quipu-historias a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        font-family: var(--fuente-narrativa);
        font-weight: 600;
        color: var(--color-acento);
        text-decoration: none;
    }

    @media (hover: hover) {
        .quipu-historias a:hover {
            text-decoration: underline;
        }
    }

    .quipu-historias p {
        margin: 0 0 var(--esp-xs);
        color: var(--color-texto);
        font-size: var(--paso--1);
    }

    .quipu-semana--vacia .quipu-semana__contenido {
        min-height: 1.5rem;
    }

    .quipu-hueco {
        display: grid;
        grid-template-columns: 1.25rem 1fr;
        column-gap: var(--esp-s);
    }

    .quipu-hueco__texto {
        grid-column: 2;
        align-self: center;
        color: var(--color-metadato);
        font-size: var(--paso--1);
        font-style: italic;
    }
</style>
