---
import {
    brandRoute,
    editorialContentRoute,
    homeRoute,
    reportRoute,
    siteCodeRoute
} from "../lib/routes";

const base = import.meta.env.BASE_URL;
const inicio = homeRoute(base);

// El pie es el principio de transparencia hecho navegación: desde aquí se
// llega al contenido editorial, al código que lo publica y a los criterios de
// marca con los que se escribe.
//
// Estos destinos son páginas del sitio y ya no repositorios de GitHub: la
// transparencia se explica en el idioma de quien lee, y quien quiera la fuente
// completa la encuentra enlazada al pie de cada una (issue #28).
//
// La nota junto al nombre de la marca ya no habla de fuentes ni de historial
// —eso quedó cubierto por los enlaces de abajo— sino que cierra la visita con
// la misión del proyecto (issue #32).
const enlaces = [
    { texto: "Contenido editorial", href: editorialContentRoute(base) },
    { texto: "Código del sitio", href: siteCodeRoute(base) },
    { texto: "Esencia de marca", href: brandRoute(base) },
    { texto: "Reportar un problema", href: reportRoute(base) }
] as const;
---

<footer class="pie">
    <div class="contenedor pie__interior">
        <div class="pie__marca">
            <a class="pie__logo" href={inicio}>Mistorias</a>

            <p class="pie__nota">
                No queremos solo informarte. Queremos que veas, entiendas y
                quieras transformar la educación.
            </p>
        </div>

        <nav aria-label="Enlaces del pie">
            <ul class="pie__lista" role="list">
                {
                    enlaces.map((enlace) => (
                        <li>
                            <a class="pie__enlace" href={enlace.href}>
                                {enlace.texto}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</footer>

<style>
    .pie {
        margin-block-start: var(--esp-2xl);
        border-block-start: 1px solid var(--color-borde);
        background-color: var(--color-superficie);
    }

    /* Columna, no fila: así `.pie__marca` y `<nav>` miden el 100% del ancho
       del pie por el `stretch` (por defecto) del eje transversal, sin media
       query. Sin eso, "a la derecha" y "centrado" solo tendrían sentido
       contra el hueco que le sobra a cada bloque, no contra la página. */
    .pie__interior {
        display: flex;
        flex-direction: column;
        gap: var(--esp-m);
        padding-block: var(--esp-l);
    }

    /* Sin `align-items` propio: el `stretch` por defecto de flexbox iguala
       el alto del enlace y el de la nota, cualquiera sea el más alto —así
       "el mismo tamaño vertical" no depende de un número fijo. */
    .pie__marca {
        display: flex;
        gap: var(--esp-xs);
    }

    /* El nombre de la marca, no el logotipo completo: solo texto, en el
       mismo tratamiento que la palabra dentro de LogotipoMistorias (Lora
       600, --color-acento). `flex` + `align-items: center` lo centra
       verticalmente dentro del alto que le da el `stretch` del padre;
       `min-height` es el mismo piso de blanco de toque que ya usan
       `.pie__enlace` y `.cabecera__enlace`, para cuando la nota es corta. */
    .pie__logo {
        display: flex;
        flex: none;
        align-items: center;
        min-height: 44px;
        font-family: var(--fuente-narrativa);
        font-size: var(--paso--1);
        font-weight: 600;
        color: var(--color-acento);
        text-decoration: none;
        white-space: nowrap;
    }

    .pie__nota {
        /* El margen automático consume el espacio libre de la fila antes
           del elemento, así su borde derecho llega al borde derecho de
           `.pie__marca` (ya 100% del pie) en vez de quedar pegado a
           `.pie__logo`. En viewports angostos, sin espacio libre, se
           resuelve a 0 y el comportamiento es el de siempre. */
        margin-inline-start: auto;
        max-width: 42ch;
        font-size: var(--paso--1);
        color: var(--color-metadato);
        /* A la derecha, contra el nombre de marca a su izquierda. */
        text-align: right;
    }

    .pie__lista {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--esp-2xs) var(--esp-m);
        padding: 0;
        list-style: none;
    }

    .pie__enlace {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        text-decoration: none;
    }

    @media (hover: hover) {
        .pie__logo:hover,
        .pie__enlace:hover {
            text-decoration: underline;
        }
    }
</style>
