---
import { rutaInicio } from "../lib/rutas";

const inicio = rutaInicio(import.meta.env.BASE_URL);

// El pie es el principio de transparencia hecho navegación: desde acá se llega
// al contenido editorial, al código que lo publica y a los criterios de marca
// con los que se escribe.
const enlaces = [
    {
        texto: "Contenido editorial",
        href: "https://github.com/mistorias/mistorias-contenido"
    },
    {
        texto: "Código del sitio",
        href: "https://github.com/mistorias/mistorias-web"
    },
    {
        texto: "Esencia de marca",
        href: "https://github.com/mistorias/mistorias-esencia-de-marca"
    },
    {
        texto: "Reportar un problema",
        href: "https://github.com/mistorias/mistorias-web/blob/main/SECURITY.md"
    }
] as const;
---

<footer class="pie">
    <div class="contenedor pie__interior">
        <div class="pie__marca">
            <a class="pie__logo" href={inicio}>Mistorias</a>

            <p class="pie__nota">
                Cada historia de Mistorias enlaza sus fuentes y dice qué son. El
                contenido y el código son públicos y tienen historial.
            </p>
        </div>

        <nav aria-label="Enlaces del pie">
            <ul class="pie__lista" role="list">
                {
                    enlaces.map((enlace) => (
                        <li>
                            <a class="pie__enlace" href={enlace.href}>
                                {enlace.texto}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</footer>

<style>
    .pie {
        margin-block-start: var(--esp-2xl);
        border-block-start: 1px solid var(--color-borde);
        background-color: var(--color-superficie);
    }

    .pie__interior {
        display: flex;
        flex-wrap: wrap;
        gap: var(--esp-m);
        justify-content: space-between;
        padding-block: var(--esp-l);
    }

    /* Sin `align-items` propio: el `stretch` por defecto de flexbox iguala
       el alto del enlace y el de la nota, cualquiera sea el más alto —así
       "el mismo tamaño vertical" no depende de un número fijo. */
    .pie__marca {
        display: flex;
        gap: var(--esp-xs);
    }

    /* El nombre de la marca, no el logotipo completo: solo texto, en el
       mismo tratamiento que la palabra dentro de LogotipoMistorias (Lora
       600, --color-acento). `flex` + `align-items: center` lo centra
       verticalmente dentro del alto que le da el `stretch` del padre;
       `min-height` es el mismo piso de blanco de toque que ya usan
       `.pie__enlace` y `.cabecera__enlace`, para cuando la nota es corta. */
    .pie__logo {
        display: flex;
        flex: none;
        align-items: center;
        min-height: 44px;
        font-family: var(--fuente-narrativa);
        font-size: var(--paso--1);
        font-weight: 600;
        color: var(--color-acento);
        text-decoration: none;
        white-space: nowrap;
    }

    .pie__nota {
        max-width: 42ch;
        font-size: var(--paso--1);
        color: var(--color-metadato);
        /* A la derecha, contra el nombre de marca a su izquierda; la última
           línea —normalmente más corta— se centra en vez de quedar pegada
           al borde. */
        text-align: right;
        text-align-last: center;
    }

    .pie__lista {
        display: flex;
        flex-wrap: wrap;
        gap: var(--esp-2xs) var(--esp-m);
        padding: 0;
        list-style: none;
    }

    .pie__enlace {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        text-decoration: none;
    }

    @media (hover: hover) {
        .pie__logo:hover,
        .pie__enlace:hover {
            text-decoration: underline;
        }
    }
</style>
