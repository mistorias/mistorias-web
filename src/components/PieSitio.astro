---
import {
    brandRoute,
    editorialContentRoute,
    homeRoute,
    reportRoute,
    siteCodeRoute
} from "../lib/routes";
import RedesSociales from "./RedesSociales.astro";

const base = import.meta.env.BASE_URL;
const inicio = homeRoute(base);

// El pie es el principio de transparencia hecho navegación: desde aquí se
// llega al contenido editorial, al código que lo publica y a los criterios de
// marca con los que se escribe.
//
// Estos destinos son páginas del sitio y ya no repositorios de GitHub: la
// transparencia se explica en el idioma de quien lee, y quien quiera la fuente
// completa la encuentra enlazada al pie de cada una (issue #28).
//
// La nota junto al nombre de la marca ya no habla de fuentes ni de historial
// —eso quedó cubierto por los enlaces de abajo— sino que cierra la visita con
// la misión del proyecto (issue #32). Desde el issue #148 esa misma nota
// termina invitando a seguir a Mistorias en redes, con los íconos al lado: la
// invitación llega cuando la lectura ya terminó, sin taparla. Ver ADR 0021.
const enlaces = [
    { texto: "Contenido editorial", href: editorialContentRoute(base) },
    { texto: "Código del sitio", href: siteCodeRoute(base) },
    { texto: "Esencia de marca", href: brandRoute(base) },
    { texto: "Reportar un problema", href: reportRoute(base) }
] as const;
---

<footer class="pie">
    <div class="contenedor pie__interior">
        <div class="pie__marca">
            <div class="pie__franja">
                <a class="pie__logo" href={inicio}>Mistorias</a>

                <p class="pie__nota">
                    No queremos solo informarte: cada semana, una historia para
                    que veas, entiendas y quieras transformar la educación.{" "}
                    <span id="pie-invitacion" class="pie__invitacion">
                        Síguenos y no te pierdas la próxima.
                    </span>
                </p>

                <RedesSociales etiquetadoPor="pie-invitacion" />
            </div>
        </div>

        <nav aria-label="Enlaces del pie">
            <ul class="pie__lista" role="list">
                {
                    enlaces.map((enlace) => (
                        <li>
                            <a class="pie__enlace" href={enlace.href}>
                                {enlace.texto}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</footer>

<style>
    .pie {
        margin-block-start: var(--esp-2xl);
        border-block-start: 1px solid var(--color-borde);
        background-color: var(--color-superficie);
    }

    /* Columna, no fila: así `.pie__marca` y `<nav>` miden el 100% del ancho
       del pie por el `stretch` (por defecto) del eje transversal, sin media
       query. Sin eso, "a la derecha" y "centrado" solo tendrían sentido
       contra el hueco que le sobra a cada bloque, no contra la página. */
    .pie__interior {
        display: flex;
        flex-direction: column;
        gap: var(--esp-m);
        padding-block: var(--esp-l);
    }

    /* La franja de marca: nombre, nota y redes, separada de los enlaces por
       la misma línea que separa el pie del contenido.

       Es un contenedor (`container-type`) porque lo que decide si sus tres
       piezas caben en fila es su propio ancho, no el de un dispositivo
       (ADR 0006). ADR 0012 descartó las container queries en la portada
       porque `contain: layout` desancla el panel `position: fixed` de
       `DatoConFuente`; el pie no contiene nada fijo, así que acá no aplica.
       Ver ADR 0021. */
    .pie__marca {
        container: pie-marca / inline-size;
        padding-block-end: var(--esp-m);
        border-block-end: 1px solid var(--color-borde);
    }

    /* Tres columnas: nombre, nota y redes. `align-items: center` centra el
       nombre y el bloque de redes contra el alto de la nota, cualquiera sea
       su número de líneas: con dos, los íconos caen entre la primera y la
       segunda; con tres, en la segunda. Como cada pieza vive en su propia
       columna, la nota crece hacia abajo y nunca se mete bajo los íconos. */
    .pie__franja {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: var(--esp-s) var(--esp-m);
    }

    /* El nombre de la marca, no el logotipo completo: solo texto, en el
       mismo tratamiento que la palabra dentro de LogotipoMistorias (Lora
       600, --color-acento). `min-height` es el mismo piso de blanco de toque
       que ya usan `.pie__enlace` y `.cabecera__enlace`. */
    .pie__logo {
        display: flex;
        align-items: center;
        min-height: 44px;
        font-family: var(--fuente-narrativa);
        font-size: var(--paso--1);
        font-weight: 600;
        color: var(--color-acento);
        text-decoration: none;
        white-space: nowrap;
    }

    /* Pegada a las redes (`justify-self: end`) y alineada a la derecha, de
       modo que la invitación con que termina queda junto a los íconos a los
       que apunta. */
    .pie__nota {
        justify-self: end;
        max-width: 42ch;
        font-size: var(--paso--1);
        color: var(--color-metadato);
        text-align: right;
    }

    .pie__invitacion {
        font-weight: 600;
        color: var(--color-acento);
    }

    /* Bajo 36rem las tres columnas ya no caben: a 390px a la nota le
       quedarían ~110px, unos 15 caracteres por línea. Ahí se apila todo y
       se centra, y la nota recupera el ancho completo. */
    @container pie-marca (width < 36rem) {
        .pie__franja {
            grid-template-columns: 1fr;
            justify-items: center;
        }

        .pie__nota {
            justify-self: center;
            text-align: center;
        }
    }

    .pie__lista {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--esp-2xs) var(--esp-m);
        padding: 0;
        list-style: none;
    }

    .pie__enlace {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        text-decoration: none;
    }

    @media (hover: hover) {
        .pie__logo:hover,
        .pie__enlace:hover {
            text-decoration: underline;
        }
    }
</style>
