---
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import ListaTemas from "./ListaTemas.astro";
import SimboloMistorias from "./SimboloMistorias.astro";
import { dateForAttribute, readableDate } from "../lib/dates";
import { storyRoute } from "../lib/routes";
import { getStoryImage } from "../lib/content/story-images";

type Props = {
    historia: CollectionEntry<"stories">;
    destacada?: boolean;
    nivelTitulo?: 2 | 3;
};

const { historia, destacada = false, nivelTitulo = 2 } = Astro.props;
const { title, summary, date, author, themes, imageAlt } = historia.data;
const enlace = storyRoute(import.meta.env.BASE_URL, historia.id);
const imagen = getStoryImage(historia.id);

// El nivel se recibe en vez de fijarse: una tarjeta que cuelga de un encabezado
// de sección debe ser h3, y saltarse un nivel rompe la navegación por
// encabezados de los lectores de pantalla.
const Titulo = `h${nivelTitulo}` as const;
---

<article class:list={["tarjeta", destacada && "tarjeta--destacada"]}>
    <div class="tarjeta__imagen">
        <span
            class:list={["tarjeta__marcador", imagen && "tarjeta__marcador--cargando"]}
        >
            <SimboloMistorias />
        </span>
        {
            // El gate de contenido (story-image-requirements.ts) exige
            // imageAlt siempre que exista principal.jpg: si `imagen` está
            // presente, `imageAlt` también, por construcción.
            imagen && (
                <Picture
                    src={imagen}
                    alt={imageAlt!}
                    width={480}
                    height={480}
                    formats={["webp"]}
                    fallbackFormat="jpg"
                    loading="lazy"
                    class="tarjeta__foto"
                />
            )
        }
    </div>

    <Titulo class="tarjeta__titulo">{title}</Titulo>

    <p class="tarjeta__metadatos">
        <time datetime={dateForAttribute(date)}>{readableDate(date)}</time>
        <span aria-hidden="true">·</span>
        {author}
    </p>

    <p class="tarjeta__resumen">{summary}</p>

    {
        (themes ?? []).length > 0 && (
            <ListaTemas temas={themes ?? []} temaTextual={`Temas de ${title}`} />
        )
    }

    <p class="tarjeta__cta">
        <a class="tarjeta__enlace" href={enlace}>
            Leer la historia<span class="sr-only"> completa: {title}</span>
            <span aria-hidden="true">→</span>
        </a>
    </p>
</article>

<style>
    .tarjeta {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: var(--esp-xs);
        height: 100%;
        padding: var(--esp-m);
        border: 1px solid var(--color-borde);
        border-radius: var(--radio);
        background-color: var(--color-superficie);
    }

    .tarjeta--destacada {
        border-block-start: 4px solid var(--color-vivo);
    }

    /* Cuadrado siempre, tenga o no foto: así todas las tarjetas de una
       grilla miden lo mismo. La foto (si existe) se recorta 1:1 vía
       width===height en <Picture>; el símbolo va detrás y sirve tanto de
       relleno permanente (sin imagen) como de marcador mientras la foto,
       con `loading="lazy"`, todavía no pintó encima — sin una sola línea de
       JS, el navegador la tapa solo al terminar de cargar. */
    .tarjeta__imagen {
        position: relative;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: var(--radio);
        background-color: var(--color-superficie);
    }

    .tarjeta__marcador {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: var(--paso-3);
        color: var(--color-borde);
    }

    /* El shimmer solo se activa cuando hay una foto en camino (lo decide el
       propio componente, en el servidor, según haya o no `imagen`) — el
       marcador permanente de una historia sin foto se queda estático.
       `prefers-reduced-motion` ya lo cubre la regla global de base.css, que
       colapsa la duración de cualquier `animation` a 0.01ms. */
    .tarjeta__marcador--cargando {
        background-image: linear-gradient(
            110deg,
            transparent 35%,
            color-mix(in srgb, var(--color-acento) 25%, transparent) 50%,
            transparent 65%
        );
        background-size: 200% 100%;
        animation: tarjeta-marcador-shimmer 1.6s ease-in-out infinite;
    }

    @keyframes tarjeta-marcador-shimmer {
        from {
            background-position: 150% 0;
        }
        to {
            background-position: -50% 0;
        }
    }

    .tarjeta__foto {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .tarjeta__titulo {
        font-size: var(--paso-1);
        color: var(--color-texto);
    }

    .tarjeta--destacada .tarjeta__titulo {
        font-size: var(--paso-2);
    }

    .tarjeta__cta {
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        font-weight: 600;
    }

    /* Único enlace real de la tarjeta: `::after` lo estira sobre toda la
       tarjeta (que por eso es `position: relative`), así que un clic en la
       imagen, el título o el resumen navega igual sin que ninguno de ellos
       sea un enlace por sí mismo. Ver ADR 0015. */
    .tarjeta__enlace {
        position: relative;
        color: var(--color-acento);
        text-decoration: none;
    }

    .tarjeta__enlace::after {
        content: "";
        position: absolute;
        inset: 0;
    }

    @media (hover: hover) {
        .tarjeta__enlace:hover {
            text-decoration: underline;
            text-underline-offset: 0.2em;
        }

        .tarjeta:hover {
            box-shadow: 0 0 3rem 1.25rem
                color-mix(in srgb, var(--color-acento) 50%, transparent);
        }
    }

    /* El contorno de foco se dibuja sobre el `::after` (del tamaño de la
       tarjeta entera) en vez de sobre el texto "Leer la historia": así
       quien navega con teclado ve resaltada toda la tarjeta, no una línea
       diminuta al final. */
    .tarjeta__enlace:focus-visible {
        outline: none;
    }

    .tarjeta__enlace:focus-visible::after {
        outline: var(--grosor-foco) solid var(--color-vivo);
        outline-offset: 3px;
        border-radius: var(--radio);
    }

    .tarjeta:has(.tarjeta__enlace:focus-visible) {
        box-shadow: 0 0 3rem 1.25rem
            color-mix(in srgb, var(--color-acento) 50%, transparent);
    }

    /* Flex con `gap` en vez de espacios en el marcado: el compilador colapsa la
       plantilla y el separador quedaba pegado a la fecha y a la autoría. */
    .tarjeta__metadatos {
        display: flex;
        flex-wrap: wrap;
        gap: 0 0.6ch;
        font-family: var(--fuente-info);
        font-size: var(--paso--1);
        color: var(--color-metadato);
    }

    .tarjeta__resumen {
        /* El resumen de portada es lo único que compite por la atención: se le
           deja la medida de lectura aunque la tarjeta sea más ancha. */
        max-width: 60ch;
        margin-block-end: auto;
    }
</style>
