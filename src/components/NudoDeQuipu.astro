---
type Redondeo = "arriba" | "abajo" | "ambos" | "ninguno";

type Props = {
    cantidad: number;
    alto: number;
    redondeo: Redondeo;
    id: string;
};

const { cantidad, alto, redondeo, id } = Astro.props;

const ANCHO = 20;
const RADIO = 3;
/*
 * Aproximadamente el 38% del ancho de la cuerda: proporción medida en píxeles
 * sobre el hueco superior del símbolo de marca en public/android-chrome-512x512.png.
 * Este porcentaje es la clave de que el diseño se lea como coherente con la
 * identidad visual de Mistorias.
 */
const ANCHO_NUDO = 7.6;
const ALTO_NUDO = 6;

const nudosAVisualizar = Math.max(0, cantidad);

/*
 * El contorno de este tramo de cuerda redondea solo las esquinas que
 * corresponden a su posición dentro del año: la primera fila redondea arriba
 * (linda con el titular del año), la última redondea abajo (linda con el año
 * siguiente), y las del medio quedan rectas. Así, cuando dos tramos se tocan,
 * sus esquinas empalman sin dejar una hendidura (que es lo que pasaría si
 * cada tramo redondeara las cuatro esquinas).
 */
const contorno = (() => {
    const r = RADIO;
    const w = ANCHO;
    const h = alto;
    switch (redondeo) {
        case "ambos":
            return `M ${r},0 H ${w - r} A ${r},${r} 0 0 1 ${w},${r} V ${h - r} A ${r},${r} 0 0 1 ${w - r},${h} H ${r} A ${r},${r} 0 0 1 0,${h - r} V ${r} A ${r},${r} 0 0 1 ${r},0 Z`;
        case "arriba":
            return `M ${r},0 H ${w - r} A ${r},${r} 0 0 1 ${w},${r} V ${h} H 0 V ${r} A ${r},${r} 0 0 1 ${r},0 Z`;
        case "abajo":
            return `M 0,0 H ${w} V ${h - r} A ${r},${r} 0 0 1 ${w - r},${h} H ${r} A ${r},${r} 0 0 1 0,${h - r} Z`;
        default:
            return `M 0,0 H ${w} V ${h} H 0 Z`;
    }
})();

/*
 * Los nudos se distribuyen a espaciado parejo a lo largo del tramo: para N
 * nudos, el nudo i (indexado desde 0) está en altura * (i+1) / (N+1).
 * Así el primero no está en la cumbre del primer pixel ni el último en la
 * cumbre del último: quedan incrustados dentro del tramo, simétricos.
 */
const posicionesNudo = Array.from({ length: nudosAVisualizar }, (_, indice) =>
    (alto * (indice + 1)) / (nudosAVisualizar + 1)
);

const idMascara = `nudo-${id}`;
---

<svg class="nudo-de-quipu" viewBox={`0 0 ${ANCHO} ${alto}`} preserveAspectRatio="none" aria-hidden="true">
    <mask id={idMascara}>
        <path d={contorno} fill="white" />
        {posicionesNudo.map((y) => (
            <rect
                x={(ANCHO - ANCHO_NUDO) / 2}
                y={y - ALTO_NUDO / 2}
                width={ANCHO_NUDO}
                height={ALTO_NUDO}
                rx="1"
                fill="black"
            />
        ))}
    </mask>
    <path d={contorno} fill="currentColor" mask={`url(#${idMascara})`} />
</svg>

<style>
    /*
     * `height: 100%` (no `auto`): esta cuerda llena exactamente el alto que
     * le da su celda de grid en el padre, sin que tengamos que calcularlo de
     * antemano. El padre desconoce el alto real, que depende del largo del
     * texto de la semana. Con `preserveAspectRatio="none"` en el SVG, se
     * estira sin respetar proporciones.
     */
    .nudo-de-quipu {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>
